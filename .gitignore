# Python bytecode and test caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Virtual environments and local tool state
.venv/
venv/
env/
.env
.env.*
!.env.example
.mypy_cache/
.ruff_cache/
.pyre/
.tox/

# Build and packaging output
build/
dist/
*.egg-info/
node_modules/

# Local application data: weather cache, forecast history and uploaded actuals
data/*.sqlite3
data/*.sqlite3-shm
data/*.sqlite3-wal

# Temporary files produced during local verification
tmp/

# Editor and operating-system files
.vscode/
.idea/
*.swp
*.swo
Thumbs.db
Desktop.ini
